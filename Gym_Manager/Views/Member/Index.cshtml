@model IEnumerable<Gym_Manager.ViewModels.Member.MemberIndexViewModel>

@{
    ViewData["Title"] = "Members";
}

<h1>Members</h1>

<p>
    <a asp-action="Create">Create New Member</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                Trainers
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => member.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => member.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => member.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => member.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => member.TrainerNames)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@member.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@member.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@member.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
